<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>mx.neology</groupId>
    <artifactId>parking-api</artifactId>
    <version>1.0.0</version>
    <name>parking-api</name>
    <description>API base para la prueba técnica DevOps de Neology</description>

    <properties>
        <java.version>17</java.version>
        <!--
          Parches de seguridad sobre las versiones que trae Spring Boot 3.5.16
          (detectados por Trivy en la imagen). Solo cambia el número de parche,
          misma línea menor. Quitar cuando el parent de Spring Boot los incluya.
          - Jackson 2.21.4 -> 2.21.6: CVE-2026-68497 (HIGH, DoS con números sin límite)
          - pgjdbc 42.7.11 -> 42.7.12: CVE-2026-54291 (HIGH, downgrade de SCRAM)
          Tomcat 10.1.58 (parche de 3 CVE) aún no está publicado en Maven Central:
          excepción temporal en .trivyignore; fijar tomcat.version aquí cuando salga.
        -->
        <jackson-bom.version>2.21.6</jackson-bom.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Métricas en formato Prometheus en /actuator/prometheus (puerto de gestión) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

