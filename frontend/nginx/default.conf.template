# Plantilla procesada por envsubst al iniciar el contenedor.
# Variables sustituidas: ${BACKEND_URL} y ${NGINX_LOCAL_RESOLVERS} (esta última la calcula
# la imagen a partir de /etc/resolv.conf cuando NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1).

# Log de acceso en JSON: una línea por petición, con el mismo request_id que registra el backend.
log_format json_combined escape=json '{'
    '"time":"$time_iso8601",'
    '"request_id":"$request_id",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"upstream_status":"$upstream_status",'
    '"upstream_response_time":"$upstream_response_time",'
    '"user_agent":"$http_user_agent"'
'}';

server {
    listen 8080;
    server_name _;
    server_tokens off;          # no revela la versión de nginx

    access_log /dev/stdout json_combined;
    error_log  /dev/stderr warn;

    root  /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;    # la API solo recibe JSON pequeño

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # DNS en tiempo de petición: nginx arranca aunque el backend todavía no exista
    # y detecta la nueva IP cuando el contenedor del backend se recrea.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_URL};

    # --- API: proxy al backend (solo /neo; Actuator NO se expone) ---
    location /neo/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Request-ID      $request_id;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout    30s;

        # Un solo X-Request-ID en la respuesta, incluso si el backend no responde (502/504)
        proxy_hide_header X-Request-ID;
        add_header X-Request-ID $request_id always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Endpoint propio del contenedor para health checks (no depende del backend)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- Archivos con hash en el nombre: caché larga e inmutable ---
    location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # --- SPA: cualquier otra ruta devuelve index.html (sin caché) ---
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
