# Copiar a .env y reemplazar los valores:  cp .env.example .env
# .env está en .gitignore: nunca se versiona.
#
# Generar un password aleatorio:
#   openssl rand -base64 24

# --- PostgreSQL ---
POSTGRES_DB=parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=CAMBIAR_POR_UN_PASSWORD_ALEATORIO

# --- Puertos publicados en el host ---
# Solo el frontend se publica. El backend y la base de datos quedan en la red interna.
FRONTEND_PORT=4200

# --- Backend ---
# Tamaño del pool de conexiones por instancia (conexiones_totales = instancias x pool)
DB_POOL_SIZE=10
# Nivel de log de la aplicación (INFO en producción)
LOG_LEVEL=INFO

# --- Imágenes (vacío = build local) ---
# Para usar imágenes publicadas por el pipeline:
#   IMAGE_REGISTRY=ghcr.io/<usuario>/devops-prueba-tecnica-neology
#   IMAGE_TAG=sha-abc1234
IMAGE_REGISTRY=local
IMAGE_TAG=dev
